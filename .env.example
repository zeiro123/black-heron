# Copy this file to .env (the real .env is gitignored). Used by the database scripts in server/.
# The project runs its own PostgreSQL cluster on port 5433 (port 5432 belongs to an existing service).
DATABASE_URL=postgres://postgres@localhost:5433/chess_coach

# Lichess personal API token (server-side only — NEVER in frontend code). Create one at
# https://lichess.org/account/oauth/token
LICHESS_API_TOKEN=lip_yourtokenhere
